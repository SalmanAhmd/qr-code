# ---------------------------------------------------------------------------
# LinkCraft server configuration
# Copy this file to `.env` (repo root or server/ folder) and adjust the values.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# Public base URL used to build short links, e.g. https://links.your-domain.com
# No trailing slash. In production this MUST be your real domain.
BASE_URL=http://localhost:4000

# Where the SQLite database file lives (relative to the server/ folder).
DATABASE_PATH=data/linkcraft.db

# Comma separated list of allowed browser origins for the API.
# Use "*" only for local development.
CORS_ORIGIN=*

# Number of proxy hops to trust for the client IP (needed behind a reverse proxy).
# Use 0 / false when not running behind a proxy.
TRUST_PROXY=false

# Serve the built React app (client/dist) from the Express server.
# Defaults to true when NODE_ENV=production.
SERVE_CLIENT=false

# Path to the built client, relative to the repository root.
CLIENT_DIST_PATH=client/dist

# Global rate limit for every request (per IP).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Stricter rate limit for POST /api/shorten (per IP).
SHORTEN_RATE_LIMIT_WINDOW_MS=3600000
SHORTEN_RATE_LIMIT_MAX=30

# Block links that point to private networks (10.x, 192.168.x, 127.0.0.1, ...).
# Defaults to true when NODE_ENV=production.
BLOCK_PRIVATE_DESTINATIONS=false

# ---------------------------------------------------------------------------
# Client configuration (Vite). Only variables prefixed with VITE_ are exposed
# to the browser bundle. Leave empty to use the same origin as the API.
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=
# VITE_DEV_API_TARGET=http://localhost:4000
